<!-- snippets/mobile-nav.liquid -->

{%- doc -%}
  Provides the wrapper structure for the mobile navigation drawer.
  Moonflower layout: search + bag + close row, drill-down menu, then
  account links and localization pinned to the bottom (assets/mf-nav.css).
{%- enddoc -%}

{%- liquid
  assign close_t = 'general.a11y.close' | t
  assign search_t = 'general.search.search' | t
  assign cart_title_t = 'cart.title_' | append: settings.cart--label | t
-%}

<div class="mobile-nav">
  <div class="mf-dn__top">
    {%- if settings.search-enabled -%}
      <form class="mf-dn__search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="mf-dn__search-label" for="mf-dn-search">{{ search_t }}</label>
        {%- render 'icons', icon: 'search' -%}
        <input
          id="mf-dn-search"
          class="mf-dn__search-input"
          type="search"
          name="q"
          placeholder="{{ search_t }}"
          autocomplete="off"
          enterkeyhint="search"
        >
        <input type="hidden" name="options[prefix]" value="last">
      </form>
    {%- endif -%}

    <a
      class="mf-dn__icon"
      aria-label="{{ cart_title_t }}"
      {% if settings.cart--type == 'drawer' %}
        data-drawer-open="right"
        data-drawer-view="cart-drawer"
        aria-haspopup="menu"
        href="#"
      {% else %}
        href="{{ routes.cart_url }}"
      {% endif %}
    >
      {%- render 'icons', icon: settings.cart--label -%}
    </a>

    <button class="mf-dn__icon mf-dn__close" type="button" data-drawer-close aria-label="{{ close_t }}">
      <span aria-hidden="true"></span>
    </button>
  </div>

  <ul class="mobile-nav--utilities" data-text-color="body" data-mq="small">
    <li class="mobile-nav--search">
      {%- comment %} Copied from header {% endcomment -%}
    </li>
    <li class="mobile-nav--account">
      {%- comment %} Copied from header {% endcomment -%}
    </li>
  </ul>

  <nav class="mobile-nav--menu" data-item="nav-text">
    {%- comment %} Copied from header {% endcomment -%}
  </nav>

  <div class="mobile-nav--footer">
    <ul class="mobile-nav--links">
      {%- comment %} Copied from header {% endcomment -%}
    </ul>

    <div class="mobile-nav--social-icons">
      {%- comment %} Copied from announcement {% endcomment -%}
    </div>

    <div class="mobile-nav--localization">
      {%- comment %} Copied from announcement or header {% endcomment -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .mobile-nav {
    display: flex;
    flex-direction: column;
    min-height: 100vh;

    @media (max-width: 767px) {
      min-height: 100dvh;
    }
  }

  .mobile-nav--utilities {
    display: flex;
    flex-direction: column;
    padding: var(--spacing--block) var(--spacing--item) 0 var(--spacing--item);

    &:has(> :first-child:empty):has(> :last-child:empty) {
      display: none;
    }

    > *:empty {
      display: none;
    }
  }

  .mobile-nav--social-icons {
    display: contents;

    &:has(.social-media--root:empty),
    &:empty {
      display: none;
    }
  }

  .mobile-nav--footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }

  .mobile-nav--localization {
    display: inline-flex;

    &:empty {
      display: none;
    }
  }
{% endstylesheet %}
