{%- doc -%}
  Moonflower design layer (assets/mf.css, assets/mf-nav.css) + soft scroll reveal for .mf-reveal elements.
{%- enddoc -%}

{{ 'mf.css' | asset_url | stylesheet_tag }}
{{ 'mf-nav.css' | asset_url | stylesheet_tag }}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const els = document.querySelectorAll('.mf-reveal');
    if (!('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('is-in')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  });
  document.addEventListener('shopify:section:load', (ev) => {
    ev.target.querySelectorAll('.mf-reveal').forEach((el) => el.classList.add('is-in'));
  });
</script>
